# Copy to arwen.env and fill in, then: chmod 600 arwen.env
#
# arwen.env is gitignored. Never commit real credentials.
# Lines starting with # are comments; blank lines are ignored.
# Values may be wrapped in one layer of matching single or double quotes.

ARWEN_CALDAV_URL=https://caldav.example.org
ARWEN_CALDAV_USERNAME=user@example.org
ARWEN_CALDAV_PASSWORD=
